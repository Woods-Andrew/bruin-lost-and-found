# University access
ALLOWED_EMAIL_DOMAINS=ucla.edu
STAFF_EMAILS=staff@ucla.edu,lostandfound@ucla.edu
SESSION_SECRET=replace-with-a-long-random-string

# Supabase (leave blank to run labeled demo mode with sample items)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Qwen inference endpoints (OpenAI-compatible / vLLM)
# Leave blank to use clearly labeled mock vision and mock embeddings.
QWEN_API_KEY=
QWEN_VISION_URL=
QWEN_VISION_MODEL=Qwen3-VL
QWEN_EMBEDDING_URL=
QWEN_EMBEDDING_MODEL=Qwen3-VL-Embedding
QWEN_RERANK_URL=
QWEN_RERANK_MODEL=Qwen3-VL-Reranker
EMBEDDING_DIM=1024
